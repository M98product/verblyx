  "content": {
    "a1u1l1": {
      "goal": "Saluer quelqu'un et dire au revoir selon le moment de la journée.",
      "understand": {
        "text": "Hello veut dire bonjour, à tout moment. Hi est plus familier. Le matin on dit Good morning, le soir Good evening. Pour partir : Goodbye ou Bye.",
        "examples": [["Hello!", "Bonjour !"], ["Good morning, Sarah.", "Bonjour, Sarah. (le matin)"], ["How are you?", "Comment vas-tu ?"], ["I'm fine, thank you.", "Je vais bien, merci."], ["Goodbye! See you tomorrow.", "Au revoir ! À demain."]]
      },
      "analyze": {
        "sentence": "How are you?",
        "parts": [["How", "comment"], ["are", "es / êtes (verbe be)"], ["you", "tu / vous"]],
        "tip": "you veut dire tu ET vous : l'anglais n'a qu'un seul mot.",
        "words": [["hello", "bonjour"], ["goodbye", "au revoir"], ["morning", "matin"], ["evening", "soir"], ["thank you", "merci"], ["fine", "bien"]]
      },
      "practice": [
        { "type": "match", "pairs": [["hello", "bonjour"], ["goodbye", "au revoir"], ["thank you", "merci"], ["morning", "matin"]], "skill": "vocabulary" },
        { "type": "mcq", "q": "Il est 9 h du matin. Que dis-tu ?", "options": ["Good morning", "Good evening", "Goodbye"], "answer": "Good morning", "explain": "Good morning s'utilise le matin, jusqu'à midi environ.", "skill": "vocabulary" },
        { "type": "tr_en_fr", "q": "How are you?", "answer": "Comment vas-tu", "extra": ["Où", "es"], "explain": "How = comment, are you = vas-tu.", "skill": "questions" },
        { "type": "listen", "q": "Good evening", "extra": ["morning", "night"], "skill": "vocabulary" },
        { "type": "fill", "q": "I'm fine, thank ___.", "answer": "you", "explain": "On dit toujours thank you (merci).", "skill": "vocabulary" },
        { "type": "order", "answer": "Nice to meet you", "extra": ["are"], "hint": "Enchanté(e)", "skill": "word_order" }
      ],
      "master": [
        { "type": "tr_fr_en", "q": "Bonsoir, comment vas-tu ?", "answer": "Good evening how are you", "extra": ["morning", "is"], "explain": "Bonsoir = Good evening, comment vas-tu = how are you.", "skill": "questions" },
        { "type": "mcq", "q": "Ton ami part. Que dis-tu ?", "options": ["Goodbye!", "Hello!", "Good morning!"], "answer": "Goodbye!", "explain": "Goodbye (ou Bye) sert à dire au revoir.", "skill": "vocabulary" },
        { "type": "talk", "q": "How are you today?", "sample": "I'm fine, thank you!", "need": ["I"], "skill": "be_have" }
      ]
    },
    "a1u1l2": {
      "goal": "Dire son prénom, son âge et son pays, et poser ces questions.",
      "understand": {
        "text": "Pour ton prénom : My name is… ou I'm… (I'm = I am). Pour ton pays : I'm from… Pour ton âge, on utilise « être » : I'm 25 = j'ai 25 ans.",
        "examples": [["My name is Léa.", "Je m'appelle Léa."], ["I'm from Belgium.", "Je viens de Belgique."], ["I'm 30.", "J'ai 30 ans."], ["What's your name?", "Comment t'appelles-tu ?"], ["Where are you from?", "D'où viens-tu ?"]]
      },
      "analyze": {
        "sentence": "I'm from Canada.",
